# ---------------------------------------------------------------- server
PORT=3000
HOST=0.0.0.0
# comma separated list; empty = reflect any origin (dev)
CORS_ORIGIN=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# where snapshots, documents, checklist photos and generated reports are stored (served at /uploads)
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------- database: SQL Server (production)
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=CongruenceEye
DB_ENCRYPT=false
DB_TRUST_CERT=true
# true = TypeORM creates/updates the schema on boot (first boot of a fresh DB);
# false = use database/01_schema.sql
DB_SYNC=false
DB_LOGGING=false

# ---------------------------------------------------------------- database: SQLite (local dev / tests)
# DB_TYPE=sqlite
# DB_PATH=./data/dev.sqlite
# DB_SYNC=true

# ---------------------------------------------------------------- v2: AI service, media
# ai-service base URL for AI-in-Checklist (Settings.aiServiceUrl overrides it)
AI_SERVICE_URL=http://localhost:8000
AI_CHECK_TIMEOUT_MS=20000
# ffmpeg used for recap videos; defaults to the npm ffmpeg-static binary
# FFMPEG_PATH=/usr/bin/ffmpeg

# ---------------------------------------------------------------- jobs
# set to true to disable all cron jobs (alerts every minute, rollups every 5 min, report schedules hourly)
DISABLE_CRON=false
# seconds without heartbeat before a camera is marked OFFLINE (0 = never)
CAMERA_STALE_SEC=180

# ---------------------------------------------------------------- email (optional; Settings page values take precedence)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@congruence.in

# ---------------------------------------------------------------- seed
# SEED_RESET=true drops and recreates all tables before seeding
SEED_RESET=false
SEED_DAYS=90

# ---------------------------------------------------------------- recorders (contract v3)
# Key material for AES-256-GCM encryption of DVR/NVR passwords. Unset = development key + a warning at boot.
# Keep it stable: a new value makes the stored recorder passwords unreadable.
RECORDER_SECRET=
