# --- backend -------------------------------------------------------------
BACKEND_URL=http://localhost:3000
# Edge API key of this store's edge device (Admin > Edge devices). Dev seed: dev-edge-key-store-<storeId>
EDGE_API_KEY=dev-edge-key-store-1

# --- model ---------------------------------------------------------------
MODEL_PATH=models/yolo11n.pt
CONF=0.35
DEVICE=cpu            # cpu | 0 (first CUDA GPU) | cuda:0
IMGSZ=640
TARGET_FPS=5

# --- periodic outputs (seconds) -----------------------------------------
HEARTBEAT_SEC=30
FLUSH_SEC=5
SNAPSHOT_SEC=60
HEATMAP_SEC=300
QUEUE_SNAPSHOT_SEC=30

# --- offline spool (no data loss while the backend/network is down) -------
SPOOL_DIR=./spool
SPOOL_MAX_ROWS=200000

# --- staff / analytics ---------------------------------------------------
# Congruence uniform colour as OpenCV HSV ranges [[lowH,lowS,lowV],[highH,highS,highV]] (H 0-179)
STAFF_UNIFORM_HSV=[[[80,120,60],[95,255,255]]]
STAFF_ZONE_MODE=mark_staff     # mark_staff | breach (non-uniform person in STAFF_ONLY zone -> SOP_BREACH)
ENABLE_DEMOGRAPHICS=true
MODELS_DIR=./models
COUNTER_UNATTENDED_SEC=60
STAFF_ABSENT_SEC=900

# --- cameras -------------------------------------------------------------
# Optional overrides of the RTSP URL configured in the web app (testing with files):
#   JSON {"1":"/videos/entrance.mp4"}  or  1=/videos/entrance.mp4,2=rtsp://user:pass@10.0.0.12:554/...
CAMERA_SOURCE_OVERRIDES=
FILE_LOOP=true

# --- API -----------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# --- AI Manager / AI-in-Checklist (contract v2) -----------------------------------
AI_COOLDOWN_SEC=600          # one detection per rule+camera per incident window
SHELF_CHECK_SEC=30           # STOCK_OUT evaluation interval
PHONE_CONF=0.25              # YOLO confidence for COCO class 67 (cell phone)
SPOOL_MAX_SNAPSHOTS=2000     # cap for queued PERIODIC snapshots while offline
CHECKLIST_USE_YOLO=true      # person boxes for /ai/checklist/uniform (falls back to the whole photo)

# --- DVR / NVR connection tests and LAN discovery (contract v3) --------------------
PROBE_ENABLED=true           # poll /api/ingest/probes and test streams for the web app
PROBE_POLL_SEC=5             # normal poll interval
PROBE_BURST_POLL_SEC=1       # poll interval for PROBE_BURST_WINDOW_SEC after a test was found
PROBE_BURST_WINDOW_SEC=30
PROBE_TIMEOUT_SEC=10         # RTSP/TCP open + first frame
PROBE_CONCURRENCY=4          # parallel channel tests
# FFMPEG_PATH=/usr/bin/ffmpeg  # default: ffmpeg on PATH; without it OpenCV is used
ONVIF_TIMEOUT_SEC=5          # GetStreamUri for GENERIC_ONVIF recorders
DISCOVERY_ENABLED=true       # POST /ai/discover + periodic report to /api/ingest/discovered
DISCOVERY_TIMEOUT_SEC=10
DISCOVERY_INTERVAL_SEC=3600  # 0 = only on demand
# DISCOVERY_SUBNET=192.168.1.0/24   # default: the edge's own /24
DISCOVERY_PORTS=[554]
DISCOVERY_WS_ENABLED=true    # ONVIF WS-Discovery multicast
