# Copy to .env, then: docker compose up -d --build
SA_PASSWORD=Change-Me-Str0ng!Passw0rd
JWT_SECRET=replace-with-a-long-random-string
# Encrypts DVR/NVR passwords (AES-256-GCM). Keep it stable: changing it makes stored recorder passwords unreadable
RECORDER_SECRET=replace-with-another-long-random-string
# Edge key of the store this ai-service container serves (Admin > Edge devices)
EDGE_API_KEY=dev-edge-key-store-1
AI_DEVICE=cpu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@congruence.in
